<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Punto" parent="android:Theme.Material.NoActionBar" />

    <!-- Tema de arranque: solo el fondo (mismo color que el tema de la app). La animación la hace PuntoIntroOverlay. -->
    <style name="Theme.Punto.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/punto_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.Punto</item>
    </style>
</resources>
